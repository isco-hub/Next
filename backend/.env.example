# NextCrop Backend — environment variables
# Copy to .env and fill in real values. Never commit .env to git.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://nextcrop:nextcrop@localhost:5432/nextcrop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2

# ── Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-minimum-32-characters-long-random-string
MSISDN_PEPPER=change-me-minimum-32-characters-long-random-pepper

# ── OTP / Auth ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=3
RATE_LIMIT_OTP_PER_NUMBER_PER_HOUR=5
RATE_LIMIT_OTP_PER_IP_PER_HOUR=20

# ── USSD ─────────────────────────────────────────────────────────────────────
USSD_SESSION_TTL_SECONDS=120
USSD_ALLOWED_IPS=[]
USSD_SHARED_SECRET=

# ── SMS ──────────────────────────────────────────────────────────────────────
SMS_SENDER_ID=NextCrop
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_DAILY_CAP_PER_USER=3
SMS_QUIET_START_HOUR=21
SMS_QUIET_END_HOUR=6
SMS_SPEND_ALARM_USD=50.0

# ── NASA / Earthdata ─────────────────────────────────────────────────────────
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# ── Ingestion ────────────────────────────────────────────────────────────────
INGESTION_STALE_ALERT_HOURS=48
INGESTION_MAX_RETRIES=3

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# ── Pilot grid ───────────────────────────────────────────────────────────────
PILOT_DISTRICT_IDS=["lira","dokolo","amolatar","otuke","alebtong"]
