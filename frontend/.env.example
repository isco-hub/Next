# Base path of the NextCrop API. Leave empty to use the bundled sample API (MSW).
VITE_API_BASE_URL=
# Explicitly enable sample data only for local demos/tests.
VITE_USE_MOCKS=
# Optional Sentry DSN. No personal data is sent (SEC-12).
VITE_SENTRY_DSN=
# Attribution wording for NASA data (OI-09). Provisional until approved.
VITE_NASA_ATTRIBUTION=
