{
  "name": "nextcrop",
  "private": true,
  "version": "1.0.0",
  "description": "NextCrop frontend — satellite-informed crop rotation advice for the Lango sub-region",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w @nextcrop/web",
    "build": "npm run build -w @nextcrop/web && npm run check:bundle",
    "preview": "npm run preview -w @nextcrop/web",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:i18n && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.1.1",
    "axe-core": "^4.10.3",
    "eslint": "^9.24.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.7.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.2.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.1.1"
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
